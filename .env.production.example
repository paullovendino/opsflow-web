# Used by `vite build` (mode=production). On Vercel, set the same keys
# in Project Settings → Environment Variables (Production + Preview).
#
# Origin only — no /api suffix. Axios already calls /api/v1/... and /sanctum/csrf-cookie.
VITE_API_BASE_URL=https://your-opsflow-api.vercel.app
VITE_APP_NAME=OpsFlow
